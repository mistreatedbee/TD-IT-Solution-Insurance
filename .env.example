# Web frontend (root Vite app — marketing site, customer dashboard, Admin
# Panel, Security Company Dashboard) environment variables.
#
# Actual local values live in the repo-root `.env.local` (gitignored) — Vite
# loads it automatically. This file documents what's needed; it contains no
# real values. Variables prefixed `VITE_` are inlined into the client bundle
# at build time — same pattern as the mobile app's `EXPO_PUBLIC_` vars (see
# mobile/.env.example) — so nothing here may ever be a secret. See
# docs/features/001-authentication/secrets-management-plan.md §3: no
# `VITE_`-prefixed var may hold a MongoDB or Supabase service-role/DB secret.

# --- Backend API (ADR-0003) ---
# Backend host with NO path suffix — the client appends `/api/v1/...` itself.
# Falls back to http://localhost:3000 in dev if unset; required in production
# builds (src/dashboard/api/config.ts).
VITE_API_BASE_URL=https://td-it-solution-insurance.onrender.com

# --- Supabase (customer auth — client-safe by design: anon key + RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Mobile app store links (marketing site) ---
VITE_IOS_APP_STORE_URL=
VITE_ANDROID_PLAY_STORE_URL=

# --- Feature flags ---
# VITE_FEATURE_SECURITY_OPERATOR — INC-002
# (docs/organization/incidents/INC-002-play-internal-location-reenablement.md).
# Gates the Security Company Dashboard (src/security/) — recovery case queue
# and case-detail pages, mirroring mobile's
# EXPO_PUBLIC_FEATURE_SECURITY_OPERATOR. Unlike the mobile convention, this
# flag defaults to DISABLED unless explicitly set to the literal string
# "true" — Vite env vars are set per deployment target (Vercel), so there is
# no separate local-dev-vs-CI-build distinction to fail open for. Stays off
# in every environment (including local dev) until the partner-agreement
# workstream lands and Stage 8 clears the surface (see
# docs/organization/gates/stage8-manifest.json, entry `web-security-cases`).
VITE_FEATURE_SECURITY_OPERATOR=false
