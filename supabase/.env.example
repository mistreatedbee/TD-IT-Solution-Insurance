# Supabase Edge Function secrets — copy to supabase/.env (gitignored).
# Do NOT commit real values.
# Setup guide: docs/features/001-authentication/resend-setup.md

# From Dashboard → Auth → Hooks → Send Email (full value including v1,whsec_ prefix)
SEND_EMAIL_HOOK_SECRET=v1,whsec_

# Auto-available in hosted Edge Functions; required for `supabase functions serve`
SUPABASE_URL=https://mowaqxfbwqdmjssghpvt.supabase.co

# Verified sender on your Resend domain (must match domain verification)
EMAIL_FROM=notifications@tditsolutionsinsurance.co.za
EMAIL_FROM_NAME=TD IT Solution Insurance

# Resend API key (Sending access) — https://resend.com/api-keys
RESEND_API_KEY=

# Optional — defaults to https://www.tditsolutionsinsurance.co.za/logo.png
# EMAIL_PUBLIC_SITE_URL=https://www.tditsolutionsinsurance.co.za
# EMAIL_LOGO_URL=
