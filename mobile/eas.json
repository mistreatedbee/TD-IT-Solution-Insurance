{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://td-it-solution-insurance.onrender.com",
        "EXPO_PUBLIC_FEATURE_CLAIMS": "true",
        "EXPO_PUBLIC_FEATURE_LOCATION_TRACKING": "true",
        "EXPO_PUBLIC_FEATURE_KYC": "true",
        "EXPO_PUBLIC_FEATURE_ALERTS": "true",
        "EXPO_PUBLIC_FEATURE_THEFT_REPORTING": "true",
        "EXPO_PUBLIC_FEATURE_HARDWARE_TRACKING": "true",
        "EXPO_PUBLIC_FEATURE_SECURITY_OPERATOR": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://td-it-solution-insurance.onrender.com",
        "EXPO_PUBLIC_FEATURE_CLAIMS": "false",
        "EXPO_PUBLIC_FEATURE_LOCATION_TRACKING": "false",
        "EXPO_PUBLIC_FEATURE_KYC": "false",
        "EXPO_PUBLIC_FEATURE_ALERTS": "false",
        "EXPO_PUBLIC_FEATURE_THEFT_REPORTING": "false",
        "EXPO_PUBLIC_FEATURE_HARDWARE_TRACKING": "false",
        "EXPO_PUBLIC_FEATURE_SECURITY_OPERATOR": "false"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://td-it-solution-insurance.onrender.com",
        "EXPO_PUBLIC_FEATURE_CLAIMS": "false",
        "EXPO_PUBLIC_FEATURE_LOCATION_TRACKING": "false",
        "EXPO_PUBLIC_FEATURE_KYC": "false",
        "EXPO_PUBLIC_FEATURE_ALERTS": "false",
        "EXPO_PUBLIC_FEATURE_THEFT_REPORTING": "false",
        "EXPO_PUBLIC_FEATURE_HARDWARE_TRACKING": "false",
        "EXPO_PUBLIC_FEATURE_SECURITY_OPERATOR": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "SET_IN_EAS_SUBMIT_OR_APP_STORE_CONNECT",
        "ascAppId": "SET_AFTER_APP_STORE_CONNECT_APP_CREATED",
        "appleTeamId": "SET_FROM_APPLE_DEVELOPER_ACCOUNT"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
