# Backend environment variables.
#
# In this repo, actual local values live in the repo-root .env.local
# (gitignored), NOT in a backend/.env file — see backend/src/index.ts,
# which loads dotenv from ../.env.local relative to this directory.
# This file documents what's needed; it contains no real values.

# MongoDB Atlas connection string. Required — system of record for
# policies/assets/GPS history/claims (ADR-0001, ADR-0002).
MONGODB_URI=

# Supabase Postgres connection string. Optional for now — system of record
# for identity/account/session data (ADR-0002), but no live credential is
# configured yet. The backend will start without it and warn; any code path
# that requires Supabase will fail loudly if invoked (see src/db/supabase.ts).
SUPABASE_DB_URL=

# Port the Express server listens on. Defaults to 3000 if unset.
# On Render, leave unset — Render sets this itself and expects the app to
# bind to it, which this app already does.
PORT=3000

# Comma-separated list of allowed CORS origins (ADR-0003). Required once the
# frontend calls this backend cross-origin — fails closed (no origin allowed)
# if unset, not permissive-by-default. Example:
# CORS_ALLOWED_ORIGINS=https://td-it-solution-insurance-alpha.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=
