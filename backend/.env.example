# Backend environment variables.
#
# In this repo, actual local values live in the repo-root .env.local
# (gitignored), NOT in a backend/.env file — see backend/src/index.ts,
# which loads dotenv from ../.env.local relative to this directory.
# This file documents what's needed; it contains no real values.

# --- MongoDB (ADR-0001/ADR-0002 — policies/assets/GPS/claims) ---

# MongoDB Atlas connection string. Required — fails fast at startup if unset.
MONGODB_URI=

# --- Supabase (ADR-0002 — identity/account/session data) ---
# Stage 9: all three below are fail-fast required (security-review.md
# SR-17). SUPABASE_ANON_KEY is deliberately absent from this list and must
# NEVER be set in any environment — see config/env.ts's header comment and
# security-review.md SR-4.

# Supabase project's REST/GoTrue API base URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Supabase service-role key. Highest-sensitivity secret in this inventory —
# bypasses RLS entirely. Used ONLY by src/db/supabase.ts for GoTrue Admin
# API calls; never for direct app-schema data access (SR-3).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for the `app` schema, using the
# dedicated least-privilege application role (SR-3) — NOT the project
# superuser, and NOT the separately-held migration credential.
SUPABASE_DB_URL=

# Path to a pinned, version-controlled CA certificate for
# `sslmode=verify-full` (SR-2(b)). Required in production; optional in
# local dev (falls back to encrypted-but-unverified against Supabase's
# default-trusted chain — see db/pg.ts).
SUPABASE_DB_CA_CERT_PATH=

# --- Auth email (Supabase Auth + Edge Function hook) ---
# Signup verification, password reset, and staff invitations are triggered by
# this backend via GoTrue (/resend, /recover, inviteUserByEmail). Delivery
# uses the auth-send-email Edge Function (Send Email Hook) with branded
# templates — see supabase/README.md. Configure hook secrets + Resend or
# Brevo in Supabase Edge Function secrets; allowlist redirect URLs under
# Auth → URL configuration.

EMAIL_VERIFICATION_REDIRECT_URL=tditinsurance://verify-email
PASSWORD_RESET_REDIRECT_URL=tditinsurance://reset-password
INVITATION_ACCEPT_REDIRECT_URL=tditinsurance://invitations/accept

# Optional public web base URL (non-auth flows)
APP_PUBLIC_URL=

# --- Deprecated (Brevo no longer used for auth email) ---
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=

# Must be rediss:// (TLS) whenever set (SR-2(d)). Required in production;
# optional in non-production, where an in-memory fallback is used for local
# dev ONLY (see src/db/redis.ts) — never acceptable in production.
REDIS_URL=

# --- Backend-owned session token signing (api-design.md §1) ---

# "kid1:secret1,kid2:secret2" — at least one entry required. Each secret
# must be >=32 characters. Multiple entries support key rotation: all
# listed keys remain valid for verification, SESSION_JWT_ACTIVE_KID selects
# which one signs new tokens.
SESSION_JWT_SIGNING_KEYS=

# Must name one of the kids listed in SESSION_JWT_SIGNING_KEYS.
SESSION_JWT_ACTIVE_KID=

# --- Internal service-to-service auth (SR-13) ---

# "callerName1:key1,callerName2:key2" — optional. With none set, every
# /api/v1/internal/* call is rejected (fail closed) rather than accepted
# unauthenticated. Expected to be empty today — no consuming service exists
# yet.
INTERNAL_SERVICE_KEYS=

# --- Networking ---

# Number of trusted reverse-proxy hops in front of this process (SR-7).
# Defaults to 1, matching Render's single edge hop (ADR-0003) — only change
# this if the hosting topology adds another hop (e.g. a CDN/WAF) in front.
TRUST_PROXY_HOPS=1

# Port the Express server listens on. Defaults to 3000 if unset. On Render,
# leave unset — Render sets this itself.
PORT=3000

# Comma-separated list of allowed CORS origins (ADR-0003, SR-12(a)). Fails
# closed (no cross-origin requests permitted) if unset. Example:
# CORS_ALLOWED_ORIGINS=https://td-it-solution-insurance-alpha.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=
