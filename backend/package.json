{
  "name": "td-it-solutions-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TD IT Solution Insurance — Node.js/TypeScript backend API (ADR-0001). Separate deployable from the web frontend, per ADR-0001's service decomposition.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:test-accounts": "tsx scripts/seed-test-accounts.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.18",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "eslint": "^8.50.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
